# Tavily — https://app.tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=tvly-...

# Inference via any OpenAI-compatible endpoint.
# Default: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Alternative: Nebius Token Factory — https://tokenfactory.nebius.com
# LLM_BASE_URL=https://api.studio.nebius.com/v1
# NEBIUS_API_KEY=...

# Optional model overrides
# WRITER_MODEL=google/gemini-2.5-flash
# VERIFIER_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Optional: point tracing at any OTLP collector (default: local Phoenix)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
